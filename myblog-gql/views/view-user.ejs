<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>view users</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>
    <h3>view users</h3>
    <table class="table-view">
        <tr><th>name</th>
        <th>email</th>
    <th>joining date</th></tr>
    <% userData.map(data=>{%>
        <tr>
        <td><%= data.name %></td>
        <td><%= data.email %></td>
        <td><%= data.createdAt%></td>
        <!-- <td><%= </td> -->
   <% })%>
    </table>
    
</body>
</html>
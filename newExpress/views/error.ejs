<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Error</title>
  <link rel="stylesheet" href="../assets/stylesheets/style.css">
</head>
<body>
  <h1>Error</h1>
  <h2><%= message %></h2>
  <% if (error.status) { %>
    <h3>Status: <%= error.status %></h3>
  <% } %>
  <pre><%= error.stack %></pre>
</body>
</html>
